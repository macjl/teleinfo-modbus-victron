# Copy to .env only for a new installation, then fill the observed values.
# Set the host's LAN IPv4 for GX discovery; loopback is suitable for simulation.
MODBUS_BIND=127.0.0.1
METER_PROFILE=abb_b21
TIC_DEVICE=/dev/serial/by-id/REPLACE_WITH_OBSERVED_ADAPTER_ID
# Obtain the numeric GID with: getent group dialout
TIC_DIALOUT_GID=
